@page
@model TestForMax.Pages.Projects.IndexModel
@{
    ViewData["Title"] = "Проекты";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Проекты</h1>
        <a asp-page="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Создать проект
        </a>
    </div>

    @if (!Model.Projects.Any())
    {
        <div class="alert alert-info" role="alert">
            Проекты не найдены. Создайте первый проект, нажав на кнопку "Создать проект".
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var project in Model.Projects)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="card-title mb-0">@project.Name</h5>
                        </div>
                        <div class="card-body">
                            <p class="card-text">
                                <strong>Base URL:</strong> @project.BaseUrl
                            </p>
                            <p class="card-text">
                                <small class="text-muted">Создан: @project.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                            </p>
                        </div>
                        <div class="card-footer bg-white border-top-0">
                            <div class="d-flex justify-content-between">
                                <a asp-page="Details" asp-route-id="@project.Id" class="btn btn-info btn-sm">
                                    <i class="fas fa-eye"></i> Детали
                                </a>
                                <a asp-page="Edit" asp-route-id="@project.Id" class="btn btn-warning btn-sm">
                                    <i class="fas fa-edit"></i> Изменить
                                </a>
                                <a asp-page="Delete" asp-route-id="@project.Id" class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash"></i> Удалить
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div> 