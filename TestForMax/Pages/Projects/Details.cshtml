@page "{id:int}"
@model TestForMax.Pages.Projects.DetailsModel
@{
    ViewData["Title"] = "Детали проекта";
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="./Index">Проекты</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Project.Name</li>
        </ol>
    </nav>

    <div class="row mb-4">
        <div class="col-md-8">
            <h1>@Model.Project.Name</h1>
        </div>
        <div class="col-md-4 text-end">
            <a asp-page="./Edit" asp-route-id="@Model.Project.Id" class="btn btn-warning me-2">
                <i class="fas fa-edit"></i> Изменить
            </a>
            <a asp-page="./Delete" asp-route-id="@Model.Project.Id" class="btn btn-danger">
                <i class="fas fa-trash"></i> Удалить
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow mb-4">
                <div class="card-header bg-primary text-white">
                    <h2 class="h5 mb-0">Информация о проекте</h2>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Base URL:</dt>
                        <dd class="col-sm-8">@Model.Project.BaseUrl</dd>
                        
                        <dt class="col-sm-4">Токен авторизации:</dt>
                        <dd class="col-sm-8">
                            @if (string.IsNullOrEmpty(Model.Project.AuthToken))
                            {
                                <span class="text-muted">Не указан</span>
                            }
                            else
                            {
                                <div class="text-truncate" style="max-width: 300px;">
                                    @Model.Project.AuthToken
                                </div>
                            }
                        </dd>
                        
                        <dt class="col-sm-4">Куки:</dt>
                        <dd class="col-sm-8">
                            @if (string.IsNullOrEmpty(Model.Project.Cookies))
                            {
                                <span class="text-muted">Не указаны</span>
                            }
                            else
                            {
                                <div class="text-truncate" style="max-width: 300px;">
                                    @Model.Project.Cookies
                                </div>
                            }
                        </dd>
                        
                        <dt class="col-sm-4">Создан:</dt>
                        <dd class="col-sm-8">@Model.Project.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>
                        
                        <dt class="col-sm-4">Обновлен:</dt>
                        <dd class="col-sm-8">@Model.Project.UpdatedAt.ToString("dd.MM.yyyy HH:mm")</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h2 class="h5 mb-0">API Эндпоинты</h2>
                    <a asp-page="./Endpoints/Create" asp-route-projectId="@Model.Project.Id" class="btn btn-light btn-sm">
                        <i class="fas fa-plus"></i> Добавить эндпоинт
                    </a>
                </div>
                <div class="card-body">
                    @if (!Model.ApiEndpoints.Any())
                    {
                        <div class="alert alert-info" role="alert">
                            У этого проекта пока нет API эндпоинтов. Добавьте первый эндпоинт, нажав на кнопку "Добавить эндпоинт".
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Метод</th>
                                        <th>Эндпоинт</th>
                                        <th>Создан</th>
                                        <th>Действия</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var endpoint in Model.ApiEndpoints)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-primary">@endpoint.HttpMethod</span>
                                            </td>
                                            <td>@endpoint.Endpoint</td>
                                            <td>@endpoint.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a asp-page="./Endpoints/Details" asp-route-projectId="@Model.Project.Id" asp-route-id="@endpoint.Id" class="btn btn-info btn-sm">
                                                        <i class="fas fa-eye"></i> Детали
                                                    </a>
                                                    <a asp-page="./Endpoints/Edit" asp-route-projectId="@Model.Project.Id" asp-route-id="@endpoint.Id" class="btn btn-warning btn-sm">
                                                        <i class="fas fa-edit"></i> Изменить
                                                    </a>
                                                    <a asp-page="./Endpoints/Delete" asp-route-projectId="@Model.Project.Id" asp-route-id="@endpoint.Id" class="btn btn-danger btn-sm">
                                                        <i class="fas fa-trash"></i> Удалить
                                                    </a>
                                                    <a asp-page="./Endpoints/Test" asp-route-projectId="@Model.Project.Id" asp-route-id="@endpoint.Id" class="btn btn-success btn-sm">
                                                        <i class="fas fa-play"></i> Тест
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div> 